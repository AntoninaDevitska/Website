---
interface Props {
  id: string;
  title: string;
  image: string;
  description?: string;
  enrollLink?: string;
  tags?: string[];
  buttonText?: string;
}

const { 
  id,
  title, 
  image,
  description = "Learn how to use reflection for personal and professional growth, analyze experiences, and improve decision-making skills.",
  enrollLink = "",
  tags = ["students", "professionals", "anyone seeking self-improvement"],
  buttonText = "Request Access",
} = Astro.props;

const courseData = JSON.stringify({
  title,
  description,
  image,
  enrollLink,
  tags
});
---

<article class="course-card" data-course-id={id} data-course={courseData}>
  <div class="course-image">
    <img src={image} alt={title} />
  </div>
  <div class="course-content">
    <h3 class="course-title">{title}</h3>
    
    {enrollLink ? (
      <a href={enrollLink} target="_blank" class="course-btn" onclick="event.stopPropagation();">
        {buttonText}
      </a>
    ) : (
      <button type="button" class="course-btn">
        {buttonText}
      </button>
    )}
  </div>
</article>

<style>
  .course-card {
    background: var(--color-background);
    border: 1px solid var(--color-primary);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  
  .course-card:hover {
    box-shadow: 0 8px 30px rgba(141, 119, 171, 0.15);
    transform: translateY(-4px);
  }
  
  .course-image {
    width: 100%;
    height: 214px;
    overflow: hidden;
  }
  
  .course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  
  .course-card:hover .course-image img {
    transform: scale(1.05);
  }
  
  .course-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-grow: 1;
  }
  
  .course-title {
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 18px; /* Трохи збільшив, бо тепер більше вільного місця */
    line-height: 1.4;
    color: var(--color-text-black);
    margin: 0;
  }
  
  .course-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    background: var(--color-primary);
    color: var(--color-white);
    border: none;
    border-radius: 8px;
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 16px;
    transition: all 0.3s ease;
    align-self: flex-start;
    cursor: pointer;
    margin-top: auto; /* Притискає кнопку до низу, якщо заголовки різної довжини */
  }
  
  .course-btn:hover {
    background: var(--color-primary-dark);
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .course-image { height: 180px; }
    .course-content { padding: 20px; }
  }
</style>

<script>
  document.querySelectorAll('.course-card').forEach(card => {
    card.addEventListener('click', () => {
      const courseDataStr = card.getAttribute('data-course');
      if (courseDataStr && (window as any).openCourseModal) {
        const courseData = JSON.parse(courseDataStr);
        (window as any).openCourseModal(courseData);
      }
    });
  });
</script>