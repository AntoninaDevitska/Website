---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Events', href: '/events' }
];

const events = [
  // Temporarily hidden online event card.
  // {
  //   id: 'breathe-online',
  //   tag: 'Online Event',
  //   tagType: 'past',
  //   emoji: '💻',
  //   title: 'BREATHE',
  //   subtitle: 'Teaching & Wellbeing Online Forum',
  //   description:
  //     'A professional learning event for educators who want to strengthen their clarity, emotional wellbeing, and sense of purpose. The event is live on Zoom, so you can join from anywhere in the world. Recordings are available after the event, so you can revisit the sessions at your own pace.',
  //   pills: ['📅 June 27, 2026', '💻 Live on Zoom', '🎥 Recordings available'],
  //   cta: 'Learn more',
  //   href: '/breathe-forum-v2.html',
  //   accent: 'sage',
  // },
  {
    id: 'breathe-retreat',
    tag: 'Upcoming · 2026',
    tagType: 'upcoming',
    emoji: '🌿',
    title: 'BREATHE',
    subtitle: 'Teaching & Wellbeing Retreat',
    description:
      'A retreat where pedagogy meets wellbeing — an immersive in-person experience in the Carpathian Mountains. Stop. Breathe. Feel your calling again.',
    pills: ['📅 10–12 July 2026', '🏔 Carpathian Mountains', '🌿 Voevodyno Resort'],
    cta: 'Learn More',
    href: '/breathe-forum-2.html',
    accent: 'forest',
  },
];
---

<Layout title="Events | Antonina Devitska" description="Upcoming and past educational wellbeing events by Antonina Devitska — BREATHE forums and retreats for educators.">
  <Header currentPage="events" />

  <main>
    <PageHero
      title="Events"
      breadcrumb={breadcrumb}
    />

    <section class="events-section">
      <div class="container">
        <div class="events-intro">
          <p>These are spaces for educators to pause, connect, and grow. Some happen online, some in person, but all of them are built around the same idea: teaching well starts with taking care of yourself.</p>
        </div>

        <div class="events-grid">
          {events.map(event => (
            <article class:list={['event-card', `event-card--${event.accent}`]}>
              <div class="event-card__inner">
                <div class="event-card__top">
                  <span class:list={['event-tag', `event-tag--${event.tagType}`]}>{event.tag}</span>
                  <span class="event-emoji" aria-hidden="true">{event.emoji}</span>
                </div>

                <div class="event-card__body">
                  <h2 class="event-title">{event.title}</h2>
                  <p class="event-subtitle">{event.subtitle}</p>
                  <p class="event-desc">{event.description}</p>

                  <div class="event-pills">
                    {event.pills.map(pill => (
                      <span class="event-pill">{pill}</span>
                    ))}
                  </div>
                </div>

                <div class="event-card__footer">
                  <a href={event.href} class:list={['event-cta', `event-cta--${event.accent}`]}>
                    {event.cta} →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .events-section {
    padding: 80px 0 120px;
  }

  .events-intro {
    text-align: center;
    margin-bottom: 60px;
  }

  .events-intro p {
    font-size: 20px;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── BASE CARD ── */
  .event-card {
    border-radius: 28px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
  }

  .event-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
  }

  .event-card__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 36px 36px 32px;
    gap: 0;
  }

  /* ── SAGE (online forum — light) ── */
  .event-card--sage .event-card__inner {
    background: #f4f8f3;
    border: 1px solid rgba(74, 99, 71, 0.18);
  }

  /* ── FOREST (retreat — dark) ── */
  .event-card--forest .event-card__inner {
    background: linear-gradient(145deg, #0d2016 0%, #1a3c2e 60%, #0e2318 100%);
    border: 1px solid rgba(82, 183, 136, 0.18);
  }

  /* ── TOP ROW ── */
  .event-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .event-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
  }

  .event-tag--past {
    background: rgba(138, 158, 132, 0.18);
    color: #4a6347;
  }

  .event-tag--upcoming {
    background: rgba(201, 168, 76, 0.15);
    color: #c9a84c;
    border: 1px solid rgba(201, 168, 76, 0.3);
  }

  .event-emoji {
    font-size: 28px;
  }

  /* ── BODY ── */
  .event-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .event-title {
    font-family: var(--font-primary);
    font-size: 48px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -2px;
    margin: 0;
  }

  .event-card--sage .event-title {
    color: #2c2b27;
  }

  .event-card--forest .event-title {
    color: #faf6ef;
  }

  .event-subtitle {
    font-size: 15px;
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }

  .event-card--sage .event-subtitle {
    color: #4a6347;
  }

  .event-card--forest .event-subtitle {
    color: #52b788;
  }

  .event-desc {
    font-size: 15px;
    line-height: 1.7;
    margin: 4px 0 8px;
  }

  .event-card--sage .event-desc {
    color: #7a7870;
  }

  .event-card--forest .event-desc {
    color: rgba(250, 246, 239, 0.55);
  }

  .event-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .event-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 8px;
  }

  .event-card--sage .event-pill {
    background: rgba(138, 158, 132, 0.14);
    color: #4a6347;
    border: 1px solid rgba(74, 99, 71, 0.12);
  }

  .event-card--forest .event-pill {
    border: 1px solid rgba(82, 183, 136, 0.25);
    color: rgba(250, 246, 239, 0.6);
  }

  /* ── FOOTER ── */
  .event-card__footer {
    margin-top: auto;
  }

  .event-cta {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 14px;
    transition: all 0.25s ease;
  }

  .event-cta--sage {
    background: #4a6347;
    color: #fff;
  }

  .event-cta--sage:hover {
    background: #c4714a;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(196, 113, 74, 0.3);
  }

  .event-cta--forest {
    background: linear-gradient(135deg, #c9a84c, #f0d080);
    color: #0b1a12;
  }

  .event-cta--forest:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(201, 168, 76, 0.35);
  }

  @media (max-width: 768px) {
    .events-section {
      padding: 60px 0 80px;
    }

    .events-grid {
      grid-template-columns: 1fr;
    }

    .event-card__inner {
      padding: 28px 24px 24px;
    }

    .event-title {
      font-size: 38px;
      letter-spacing: -1.5px;
    }
  }
</style>
