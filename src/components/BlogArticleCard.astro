---
interface Props {
  title: string;
  date: string;
  author: string;
  image: string;
  href?: string;
}

const { title, date, author, image, href = '#' } = Astro.props;
---

<article class="blog-article-card">
  <div class="article-image">
    <img src={image} alt={title} />
  </div>
  <div class="article-content">
    <h3 class="article-title">{title}</h3>
    
    <div class="article-footer">
      <div class="article-meta">
        <span class="meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="author-name">{author}</span>
        </span>
        <span class="meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {date}
        </span>
      </div>
      
      <a href={href} class="article-link">
        Read →
      </a>
    </div>
  </div>
</article>

<style>
  .blog-article-card {
    display: flex;
    background: var(--color-background, #fff);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 30px 0 rgba(39, 35, 74, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 157px;
  }

  .blog-article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 40px 0 rgba(39, 35, 74, 0.15);
  }

  .article-image {
    width: 190px;
    height: 100%;
    flex-shrink: 0;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-content {
    flex: 1;
    padding: 15px 25px;
    display: flex;
    flex-direction: column;
    min-width: 0; 
  }

  .article-title {
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.4;
    color: var(--color-text-dark, #27234a);
    margin: 0 0 10px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-footer {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
    min-width: 0;
  }

  .article-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0; 
    flex: 1; 
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--color-gray, #666);
    min-width: 0; 
  }

  .author-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    width: 100%;
  }

  .meta-item svg {
    color: var(--color-primary, #4caf50);
    flex-shrink: 0;
  }

  .article-link {
    display: inline-flex;
    align-items: center;
    padding: 2px 15px;
    background: var(--color-primary, #4caf50);
    border-radius: 5px;
    font-size: 12px;
    line-height: 2;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .article-link:hover {
    filter: brightness(0.9);
    transform: translateX(3px);
  }

  @media (max-width: 600px) {
    .blog-article-card {
      flex-direction: column;
      height: auto;
    }
    .article-image {
      width: 100%;
      height: 160px;
    }
    .article-footer {
      align-items: center;
      margin-top: 15px;
    }
  }
</style>